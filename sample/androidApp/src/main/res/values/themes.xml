<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Referenced directly by the plugin as postSplashScreenTheme, via
      splashScreen { androidPostSplashTheme = "@style/Theme.App.AppCompat" } in
      sample/shared/build.gradle.kts. MainActivity extends AppCompatActivity (see its
      installKmpSplash() usage), which requires a Theme.AppCompat (or descendant) theme to be
      active by the time setContentView() runs — the plugin's default generated Theme.App
      intentionally isn't one, so pure-Compose apps aren't forced onto AppCompat.
    -->
    <style name="Theme.App.AppCompat" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
