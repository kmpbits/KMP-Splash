<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Used by MainActivity only, overriding the plugin-generated splash theme at the
      <application> level. AppCompatActivity requires a Theme.AppCompat (or descendant) theme
      to be active by the time setContentView() runs, which the generated theme intentionally
      doesn't provide (pure-Compose apps shouldn't be forced onto AppCompat). Since this theme
      doesn't extend the plugin's generated splash theme, installSplashScreen() falls back to
      the OS default native splash (derived from the launcher icon) for this activity, instead
      of the configured logo/background.
    -->
    <style name="Theme.App.AppCompat" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
